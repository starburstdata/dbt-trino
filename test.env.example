# Local settings for the Starburst Galaxy integration tests.
# Copy to test.env (gitignored) and fill in. Load with:
#   set -a && . ./test.env && set +a
# or just run `make dbt-galaxy-tests`, which loads it for you.

# --- Connection used by every Galaxy test -----------------------------------
# A cluster hostname, e.g. myaccount-mycluster.trino.galaxy.starburst.io
DBT_TESTS_STARBURST_GALAXY_HOST=
# Service account name as Galaxy reports it - the '@<account>...' suffix is
# required. A trailing '/role' is optional and selects the role to connect under;
# that role needs full access to the catalog below, and routing rules match on it.
DBT_TESTS_STARBURST_GALAXY_USER=
DBT_TESTS_STARBURST_GALAXY_PASSWORD=
# Catalog the tests write to; defaults to 'iceberg' if unset. Tests carrying a
# catalog marker are the exception - they use a catalog named after the marker.
DBT_TESTS_STARBURST_GALAXY_CATALOG=

# --- Galaxy public API, used by the persist_docs sync tests ------------------
# Account URL only, e.g. https://myaccount.galaxy.starburst.io
DBT_TESTS_STARBURST_GALAXY_API_URL=
DBT_TESTS_STARBURST_GALAXY_CLIENT_ID=
DBT_TESTS_STARBURST_GALAXY_SECRET_KEY=

# --- Query routing tests ----------------------------------------------------
# The account's routing endpoint, e.g. myaccount.routing.trino.galaxy.starburst.io
DBT_TESTS_STARBURST_GALAXY_ROUTING_HOST=
# Two tags that your routing rules send to two *different* clusters. The rules
# must match the role the test user connects as, so set that role in
# DBT_TESTS_STARBURST_GALAXY_USER above, e.g. 'dbt-tests/accountadmin'.
DBT_TESTS_STARBURST_GALAXY_ROUTING_TAG_A=dbt-cluster-a
DBT_TESTS_STARBURST_GALAXY_ROUTING_TAG_B=dbt-cluster-b
# Optional. Only needed if your catch-all rule matches on a tag; leave unset if
# it is a rule on the connecting role with no tags.
DBT_TESTS_STARBURST_GALAXY_ROUTING_DEFAULT_TAG=
